# Local development only. Production access is through Tailscale Serve.
DECISION_INBOX_STATE_DIR=./.local/state
DECISION_INBOX_SIGNING_KEY=replace-with-at-least-32-random-bytes
DECISION_INBOX_PUBLISH_TOKEN=replace-with-local-publisher-token
# Production should use per-profile JSON instead of the wildcard token above.
DECISION_INBOX_PUBLISH_TOKENS={"default":"replace"}
TELEGRAM_BOT_TOKEN=replace-with-test-bot-token
TELEGRAM_OWNER_ID=0
TELEGRAM_CHAT_ID=0
DECISION_INBOX_TAILSCALE_OWNER_LOGIN=you@example.com
DECISION_INBOX_MINI_APP_URL=https://your-node.your-tailnet.ts.net:8451
DECISION_INBOX_HERMES_API_URL=http://127.0.0.1:8642
HERMES_PROFILE_API_KEYS={"default":"replace"}
DECISION_INBOX_WIKI_ROOT=./.local/fixtures/wiki
DECISION_INBOX_MANIFEST_ROOT=./.local/state/manifests
DECISION_INBOX_BACKUP_ROOT=./.local/state/backups
DECISION_INBOX_WORKER_ENABLED=false
DECISION_INBOX_AUTO_RESUME=false
DECISION_INBOX_WIKI_EXECUTOR_ENABLED=false
DECISION_INBOX_WEEKLY_ONLY=true
